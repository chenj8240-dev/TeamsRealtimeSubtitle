# Dependencies
node_modules/

# Build output
/build/
/.svelte-kit/
/dist/
src-tauri/target/
# `npm run test:coverage`
/coverage/
# Playwright (`npm run test:style`, `npm run test:e2e`)
test-results/
playwright-report/
# gen/schemas is regenerated by every Tauri build; gen/windows holds the committed MSIX
# packaging inputs (manifest template, bundle config, tile assets) — see docs/packaging-msix.md.
src-tauri/gen/*
!src-tauri/gen/windows/

# One allow-/deny- pair per command, written by build.rs from the list in
# src/command_names.rs on every build. The list and the capability files are the source; these
# are the same relationship gen/schemas has, and the tests in command_names.rs check it.
src-tauri/permissions/autogenerated/

# Secrets / local config
.env
.env.local
*.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*

# Tauri signing keys, and the throwaway MSIX dev certificate (docs/packaging-msix.md)
*.key
*.pfx
*.cer
