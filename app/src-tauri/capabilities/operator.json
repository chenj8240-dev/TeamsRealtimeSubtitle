{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "operator",
  "description": "The operator window: everything the app can do. Keys, sessions, capture, the transcript and the close/quit path are reachable only from here.",
  "windows": ["operator"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-list-microphones",
    "allow-list-outputs",
    "allow-list-applications",
    "allow-has-api-key",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-ondevice-readiness",
    "allow-whisper-cpu-support",
    "allow-whisper-models",
    "allow-download-whisper-model",
    "allow-cancel-whisper-download",
    "allow-remove-whisper-model",
    "allow-discard-whisper-pending",
    "allow-start-session",
    "allow-stop-session",
    "allow-pause-session",
    "allow-start-audio-test",
    "allow-stop-audio-test",
    "allow-set-overlay-click-through",
    "allow-show-overlay",
 "allow-get-overlay-placement",
 "allow-set-overlay-placement",
    "allow-display-layout",
    "allow-recover-overlay-placement",
    "allow-save-transcript",
    "allow-text-scale-factor",
    "allow-write-recovery",
    "allow-read-recovery",
    "allow-clear-recovery",
    "allow-write-history",
    "allow-append-history",
    "allow-list-history",
    "allow-delete-history",
 "allow-rename-history",
    "allow-ack-close",
    "allow-set-close-guard",
    "allow-set-close-to-tray",
    "allow-hide-to-tray",
    "allow-show-operator",
    "allow-confirm-close",
    "allow-set-tray-state"
  ]
}
