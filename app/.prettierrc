{
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 100,
	"trailingComma": "none",
	"proseWrap": "preserve",
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": "*.{yml,yaml}",
			"options": {
				"singleQuote": false
			}
		}
	]
}
