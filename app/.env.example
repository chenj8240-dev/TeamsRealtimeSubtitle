# Copy to .env for local development. .env is gitignored.
# In production the key is stored in the OS keychain via the operator UI instead.

# Gemini API key. Covers both Gemini backends: Live Translate (translation) and
# Transcribe Live (subtitles).
# Get one at https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# OpenAI API key with access to gpt-realtime-translate (only needed for the OpenAI provider).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Mistral API key for Live subtitles (Voxtral Mini Transcribe Realtime).
# Get one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Optional model overrides (defaults are baked in; set only to experiment / pin a version).
# `.env` is loaded by debug builds only, and the *_WS_HOST overrides are ignored in release
# builds, so an installed app always connects to the provider's own endpoint.
# GEMINI_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# GEMINI_WS_HOST=generativelanguage.googleapis.com

# OpenAI provider overrides:
# OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
# OPENAI_TRANSCRIBE_MODEL=gpt-realtime-whisper
# OPENAI_WS_HOST=api.openai.com

# Mistral subtitles overrides:
# MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-transcribe-realtime-2602
# MISTRAL_TARGET_STREAMING_DELAY_MS=480
# MISTRAL_WS_HOST=api.mistral.ai
